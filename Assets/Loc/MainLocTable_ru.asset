  - m_Id: 822230994968576
    m_Localized: "\u0421\u043E\u043F\u043E\u0441\u0442\u0430\u0432\u044C\u0442\u0435
      \u0444\u043E\u0440\u043C\u0443 \u0433\u043B\u0430\u0433\u043E\u043B\u0430 \"b\u016Bti\"
      \u0441 \u043C\u0435\u0441\u0442\u043E\u0438\u043C\u0435\u043D\u0438\u0435\u043C,
      \u043A\u043E\u0442\u043E\u0440\u043E\u043C\u0443 \u043E\u043D\u0430 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1095769266483200
    m_Localized: JiNera
    m_Metadata:
      m_Items: []
  - m_Id: 1095798689525760
    m_Localized: "\u0421\u043E\u043F\u043E\u0441\u0442\u0430\u0432\u044C\u0442\u0435
      \u0444\u043E\u0440\u043C\u0443 \u0433\u043B\u0430\u0433\u043E\u043B\u0430 \"b\u016Bti\"
      \u0441 \u043C\u0435\u0441\u0442\u043E\u0438\u043C\u0435\u043D\u0438\u0435\u043C,
      \u043A\u043E\u0442\u043E\u0440\u043E\u043C\u0443 \u043E\u043D\u0430 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1101937103761408
    m_Localized: Vardi 01
    m_Metadata:
      m_Items: []
  - m_Id: 1101904799232000
    m_Localized: Vardininkas01
    m_Metadata:
      m_Items: []
  - m_Id: 1381954576609280
    m_Localized: "\u041F\u0440\u0438\u043C\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 1523854579232768
    m_Localized: Kilmi 01
    m_Metadata:
      m_Items: []
  - m_Id: 2468837708587008
    m_Localized: "\u0413\u043B\u0430\u0433\u043E\u043B\u044B \u0432 3-\u043C \u043B\u0438\u0446\u0435
      \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E
      \u0447\u0438\u0441\u043B\u0430 \u0432 \u043F\u0440\u043E\u0448\u0435\u0434\u0448\u0435\u043C
      \u043E\u0434\u043D\u043E\u043A\u0440\u0430\u0442\u043D\u043E\u043C \u0432\u0440\u0435\u043C\u0435\u043D\u0438
      \u043C\u043E\u0433\u0443\u0442 \u0438\u043C\u0435\u0442\u044C \u043E\u0434\u043D\u043E
      \u0438\u0437 \u043E\u043A\u043E\u043D\u0447\u0430\u043D\u0438\u0439: -o, -\u0117.
      \u041E\u043A\u043E\u043D\u0447\u0430\u043D\u0438\u0435 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u044F\u0435\u0442
      \u0442\u0438\u043F \u0433\u043B\u0430\u0433\u043E\u043B\u0430 \u0438 \u0442\u043E,
      \u043A\u0430\u043A \u0438\u0437\u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F
      \u0435\u0433\u043E \u0444\u043E\u0440\u043C\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2468936236982272
    m_Localized: Busi Busi
    m_Metadata:
      m_Items: []
  - m_Id: 2470580639031296
    m_Localized: "\u041F\u0440\u043E\u0448\u0435\u0434\u0448\u0435\u0435 \u043C\u043D\u043E\u0433\u043E\u043A\u0440\u0430\u0442\u043D\u043E\u0435
      \u0432\u0440\u0435\u043C\u044F \u043E\u0431\u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435, \u043A\u043E\u0442\u043E\u0440\u043E\u0435
      \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u043B\u043E\u0441\u044C \u0434\u0432\u0430
      \u0438\u043B\u0438 \u0431\u043E\u043B\u0435\u0435 \u0440\u0430\u0437\u0430.
      \u0412\u043C\u0435\u0441\u0442\u043E \u0441\u0443\u0444\u0444\u0438\u043A\u0441\u0430
      -ti \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F
      \u0441\u0443\u0444\u0444\u0438\u043A\u0441 -dav-, \u043F\u043E\u0441\u043B\u0435
      \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u044E\u0442\u0441\u044F
      \u043E\u043A\u043E\u043D\u0447\u0430\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2470839788298240
    m_Localized: Busi Daz
    m_Metadata:
      m_Items: []
  - m_Id: 2512098565349376
    m_Localized: "\u0412\u0432\u0435\u0440\u0445\u0443 \u2014 \u043F\u0435\u0440\u0435\u0432\u043E\u0434
      \u0441\u043B\u043E\u0432\u0430. \u0421\u043E\u0431\u0435\u0440\u0438\u0442\u0435
      \u043B\u0438\u0442\u043E\u0432\u0441\u043A\u043E\u0435 \u0441\u043B\u043E\u0432\u043E
      \u0438\u0437 \u0431\u0443\u043A\u0432 \u0432\u043D\u0438\u0437\u0443, \u043D\u0430\u0436\u0438\u043C\u0430\u044F
      \u043D\u0430 \u043D\u0443\u0436\u043D\u044B\u0435 \u0431\u0443\u043A\u0432\u044B
      (\u043A\u043D\u043E\u043F\u043A\u0438 \u043C\u043E\u0436\u043D\u043E \u043D\u0430\u0436\u0438\u043C\u0430\u0442\u044C
      \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0443\u0433\u043E\u0434\u043D\u043E
      \u0440\u0430\u0437). Back \u0441\u0442\u0438\u0440\u0430\u0435\u0442 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u044E\u044E
      \u0431\u0443\u043A\u0432\u0443, Check \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u0442
      \u043E\u0442\u0432\u0435\u0442, Next \u043F\u0440\u043E\u043F\u0443\u0441\u043A\u0430\u0435\u0442
      \u0441\u043B\u043E\u0432\u043E, \u0435\u0441\u043B\u0438 \u043D\u0435 \u043C\u043E\u0436\u0435\u0442\u0435
      \u0432\u0441\u043F\u043E\u043C\u043D\u0438\u0442\u044C (\u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F
      \u043A\u0430\u043A \u043E\u0448\u0438\u0431\u043A\u0430). \u041A\u0430\u0436\u0434\u043E\u0435
      \u0441\u043B\u043E\u0432\u043E \u2014 \u044D\u0442\u043E \u043E\u0434\u043D\u0430
      \u0438\u0437 \u0442\u0440\u0451\u0445 \u0444\u043E\u0440\u043C \u0433\u043B\u0430\u0433\u043E\u043B\u0430
      (\u0438\u043D\u0444\u0438\u043D\u0438\u0442\u0438\u0432, \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0435
      \u0438 \u043F\u0440\u043E\u0448\u0435\u0434\u0448\u0435\u0435 \u0432\u0440\u0435\u043C\u044F).
      \u0415\u0441\u043B\u0438 \u043E\u0448\u0438\u0431\u043B\u0438\u0441\u044C \u0438\u043B\u0438
      \u043D\u0430\u0436\u0430\u043B\u0438 Next \u2014 \u0432\u0441\u0435 \u0442\u0440\u0438
      \u0444\u043E\u0440\u043C\u044B \u044D\u0442\u043E\u0433\u043E \u0433\u043B\u0430\u0433\u043E\u043B\u0430
      \u0432\u0435\u0440\u043D\u0443\u0442\u0441\u044F \u043F\u043E\u0437\u0436\u0435
      \u0437\u0430\u043D\u043E\u0432\u043E. \u041D\u0430\u0431\u0435\u0440\u0438\u0442\u0435
      \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E \u0432\u0441\u0435 \u0442\u0440\u0438
      \u0444\u043E\u0440\u043C\u044B, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C
      \u043E\u0447\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2530852363886592
    m_Localized: "\u041E\u0442\u043B\u0438\u0447\u043D\u043E!"
    m_Metadata:
